# AgriVision environment variables
# ---------------------------------------------------------------
# 1) Copy this file to ".env"   ->  cp .env.example .env
# 2) Paste your own keys after the "=" sign
# 3) NEVER commit ".env" (it is listed in .gitignore)
# ---------------------------------------------------------------

# Google Gemini API key -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional production secret for signing rental API access tokens. If unset,
# the backend generates a process-local secret and tokens expire on restart.
AGRIVISION_AUTH_SECRET=

# Optional comma-separated browser origins (Vite defaults to localhost:5173).
# AGRIVISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Gemini model override (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Supabase PostgreSQL database credentials (migration preparation)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
